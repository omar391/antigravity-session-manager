{
    "workflow": {
        "steps": [
            {
                "action": "pressKey",
                "key": ",",
                "modifiers": "command",
                "description": "Open Settings"
            },
            {
                "action": "wait",
                "ms": 200
            },
            {
                "action": "clickAt",
                "x": 365,
                "y": 472,
                "description": "Click Account button (hardcoded position)"
            },
            {
                "action": "wait",
                "ms": 200
            },
            {
                "action": "findAndClick",
                "text": "out",
                "cacheName": "signout_button",
                "region": "right"
            },
            {
                "action": "wait",
                "ms": 100
            },
            {
                "action": "findAndClick",
                "text": "Sign",
                "cacheName": "signin_button"
            },
            {
                "action": "wait",
                "ms": 2000
            },
            {
                "action": "findAndClick",
                "text": "{targetEmail}",
                "dynamic": true,
                "cacheName": "{targetEmail}",
                "description": "Click target account email"
            },
            {
                "action": "wait",
                "ms": 2000
            },
            {
                "action": "findAndClickAny",
                "texts": [
                    "Sign in",
                    "সাইন-ইন করুন"
                ],
                "description": "Click Sign In (English or Bangla)",
                "optional": true
            },
            {
                "action": "wait",
                "ms": 1000,
                "description": "Wait for OAuth to complete"
            },
            {
                "action": "pressKey",
                "key": "w",
                "modifiers": "command",
                "description": "Close OAuth window"
            },
            {
                "action": "wait",
                "ms": 50
            },
            {
                "action": "pressKey",
                "key": "r",
                "modifiers": "command",
                "description": "Reload window"
            },
            {
                "action": "wait",
                "ms": 200,
                "description": "Wait for reload"
            }
        ]
    },
    "ocr": {
        "cacheEnabled": true,
        "cacheLifetime": 3600000,
        "fuzzyMatchThreshold": 0.8
    },
    "delays": {
        "afterSettingsOpen": 1500,
        "afterClick": 800,
        "afterSignOut": 1500,
        "afterSignIn": 2000
    }
}