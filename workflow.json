{
    "workflow": {
        "steps": [
            {
                "stepID": "open_settings",
                "action": "pressKey",
                "key": ",",
                "modifiers": "command",
                "description": "Open Settings"
            },
            {
                "stepID": "click_account",
                "action": "clickAt",
                "x": 365,
                "y": 472,
                "description": "Click Account button (hardcoded position)"
            },
            {
                "stepID": "signout_button",
                "action": "findAndClick",
                "text": "out",
                "region": "right",
                "maxWait": 3000,
                "imageTemplate": "data:image/png;base64,",
                "imageSimilarity": 0.85
            },
            {
                "stepID": "signin_button",
                "action": "findAndClick",
                "text": "Sign",
                "region": "right",
                "colorFilter": "#007AFF:0.4",
                "maxWait": 3000,
                "imageTemplate": "data:image/png;base64,",
                "imageSimilarity": 0.85
            },
            {
                "stepID": "target_email",
                "action": "findAndClick",
                "text": "{targetEmail}",
                "dynamic": true,
                "description": "Click target account email",
                "region": "center",
                "useCache": false,
                "maxWait": 10000
            },
            {
                "stepID": "oauth_signin",
                "action": "findAndClickAny",
                "texts": [
                    "Sign in",
                    "সাইন-ইন করুন"
                ],
                "description": "Click Sign In (English or Bangla)",
                "optional": true,
                "maxWait": 5000
            },
            {
                "action": "wait",
                "ms": 1000,
                "description": "Wait for OAuth to complete"
            },
            {
                "action": "pressKey",
                "key": "w",
                "modifiers": "command",
                "description": "Close OAuth window"
            }
        ]
    },
    "ocr": {
        "cacheEnabled": true,
        "cacheLifetime": 3600000,
        "fuzzyMatchThreshold": 0.8
    },
    "delays": {
        "afterSettingsOpen": 1500,
        "afterClick": 800,
        "afterSignOut": 1500,
        "afterSignIn": 2000
    }
}