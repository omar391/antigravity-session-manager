{
    "workflow": {
        "steps": [
            {
                "stepID": "open_settings",
                "action": "pressKey",
                "key": ",",
                "modifiers": "command",
                "description": "Open Settings"
            },
            {
                "stepID": "click_account",
                "action": "findAndClick",
                "text": "Account",
                "region": "left",
                "maxWait": 5000,
                "description": "Click Account button",
                "cachedX": 731,
                "cachedY": 945
            },
            {
                "stepID": "signout_button",
                "action": "findAndClick",
                "text": "Sign out",
                "region": "right",
                "maxWait": 3000,
                "imageTemplate": "data:image/png;base64,",
                "imageSimilarity": 0.99,
                "optional": true
            },
            {
                "stepID": "signin_button",
                "action": "findAndClick",
                "text": "Sign in",
                "region": "right",
                "colorFilter": "#007AFF:0.4",
                "maxWait": 3000,
                "imageTemplate": "data:image/png;base64,",
                "imageSimilarity": 0.99
            },
            {
                "stepID": "target_email",
                "action": "findAndClick",
                "text": "{targetEmail}",
                "dynamic": true,
                "description": "Click target account email",
                "region": "center",
                "useCache": false,
                "maxWait": 10000
            },
            {
                "stepID": "oauth_signin",
                "action": "findAndClickAny",
                "texts": [
                    "Sign in",
                    "সাইন-ইন করুন"
                ],
                "description": "Click Sign In (English or Bangla)",
                "optional": true,
                "maxWait": 5000,
                "imageTemplate": "data:image/png;base64,",
                "imageSimilarity": 0.99
            },
            {
                "action": "wait",
                "ms": 1000,
                "description": "Wait for OAuth to complete"
            },
            {
                "action": "pressKey",
                "key": "w",
                "modifiers": "command",
                "description": "Close OAuth window"
            }
        ]
    },
    "ocr": {
        "initialSimilarity": 0.99,
        "similarityDecayRate": 0.05,
        "minSimilarity": 0.7,
        "learningModeRetryTimeout": 300000
    }
}